# Copy to .env.local and fill in. .env.local is git-ignored; this file is not,
# so it must never hold a real value.
#
# Nothing here is needed to run the app today: `npm run dev` works with none of
# it. Each block unlocks the milestone named beside it — see SETUP.md.
#
# Rule of thumb for the NEXT_PUBLIC_ prefix: it means "this ships to the
# browser". Anything secret must NOT have it.

# --- Supabase: accounts and persistence (SETUP.md §3) ---
# Region must be EU. The service-role key is server-only — if it ever gains a
# NEXT_PUBLIC_ prefix, it is public and must be rotated immediately.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Brevo: reminder emails (SETUP.md §5) ---
# The from-address must be a sender you validated in Brevo, or sends fail.
BREVO_API_KEY=
REMINDER_FROM_EMAIL=

# --- Web push (SETUP.md §6) ---
# Generate with: npx web-push generate-vapid-keys
# Rotating these invalidates every existing subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Mistral: document parsing and grounded Q&A (SETUP.md §7) ---
MISTRAL_API_KEY=
